{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qalam Urdu Studio",
  "version": "../package.json",
  "identifier": "studio.qalam.urdu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qalam Urdu Studio",
        "width": 1366,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Urdu Nastaliq desktop publishing, created by Uzair Asad",
    "longDescription": "Qalam Urdu Studio is a desktop publishing studio for Urdu Nastaliq, Arabic and English, created by Uzair Asad. Typeset newspapers, magazines, books and documents with phonetic and traditional Urdu keyboards, multi-column page frames, tables, an Urdu dictionary, and export to PDF, Word, PNG, HTML and text.",
    "copyright": "Copyright © 2026 Uzair Asad",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "qlm",
          "qpg"
        ],
        "name": "Qalam Urdu Studio Document",
        "description": "Qalam Urdu Studio Document",
        "role": "Editor",
        "mimeType": "application/x-qalam-document"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "publisher": "Uzair Asad",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "homepage": "https://uzairasad.github.io/qalam-urdu-studio/"
  }
}
